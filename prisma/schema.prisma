generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  student
  trader
  crypto_investor
  just_exploring
  tech_savvy
}

enum UserTier {
  free
  premium
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String          @unique
  username        String          @unique
  hashedPassword  String          @map("hashed_password")
  role            UserRole        @default(just_exploring)
  tier            UserTier        @default(free)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLogin       DateTime?       @map("last_login") @db.Timestamptz(6)
  chatSessions    ChatSession[]
  trackedWallets  TrackedWallet[]

  @@map("users")
  @@index([email], map: "users_email_idx")
}

model TrackedWallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  address   String
  label     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address], map: "tracked_wallets_user_address_uniq")
  @@map("tracked_wallets")
  @@index([userId, createdAt], map: "tracked_wallets_user_created_idx")
}

model ChatSession {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  title     String        @default("New chat")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@map("chat_sessions")
  @@index([userId, updatedAt(sort: Desc)], map: "chat_sessions_user_updated_idx")
}

model ChatMessage {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @map("session_id") @db.Uuid
  role      String      // 'user' | 'assistant'
  text      String
  dataJson  Json?       @map("data_json")
  feedback  String?     // 'up' | 'down' | null
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
  @@index([sessionId, createdAt], map: "chat_messages_session_created_idx")
}
