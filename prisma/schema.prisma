generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  student
  trader
  crypto_investor
  just_exploring
  tech_savvy
}

model User {
  id                String              @id @default(uuid()) @db.Uuid
  email             String              @unique
  username          String              @unique
  hashedPassword    String?             @map("hashed_password")
  authProvider      String              @default("email") @map("auth_provider")
  role              UserRole            @default(just_exploring)
  premiumExpiresAt  DateTime?           @map("premium_expires_at") @db.Timestamptz(6)
  eliteExpiresAt    DateTime?           @map("elite_expires_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLogin         DateTime?           @map("last_login") @db.Timestamptz(6)
  chatSessions      ChatSession[]
  trackedWallets    TrackedWallet[]
  purchases         Purchase[]
  inviteRedemptions InviteRedemption[]
  messageUsages     MessageUsage[]

  @@map("users")
  @@index([email], map: "users_email_idx")
}

model Purchase {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  plan              String   // 'premium' | 'elite'
  razorpayOrderId   String   @unique @map("razorpay_order_id")
  razorpayPaymentId String?  @unique @map("razorpay_payment_id")
  amountPaise       Int      @map("amount_paise")
  periodMonths      Int      @map("period_months")
  startedAt         DateTime @map("started_at") @db.Timestamptz(6)
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("purchases")
  @@index([userId], map: "purchases_user_idx")
}

model InviteCode {
  id              String             @id @default(uuid()) @db.Uuid
  code            String             @unique
  maxRedemptions  Int                @map("max_redemptions")
  usedCount       Int                @default(0) @map("used_count")
  active          Boolean            @default(true)
  note            String?
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  redemptions     InviteRedemption[]

  @@map("invite_codes")
}

model InviteRedemption {
  id          String     @id @default(uuid()) @db.Uuid
  codeId      String     @map("code_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  redeemedAt  DateTime   @default(now()) @map("redeemed_at") @db.Timestamptz(6)
  code        InviteCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([codeId, userId], map: "invite_redemption_code_user_uniq")
  @@map("invite_redemptions")
}

model InsiderAlert {
  id          String   @id @default(uuid()) @db.Uuid
  chain       String
  kind        String   // 'whale_tx' | 'large_inflow' | 'unusual_gas'
  address     String
  txHash      String   @unique @map("tx_hash")
  amountUsd   Float?   @map("amount_usd")
  summary     String
  sourceUrl   String?  @map("source_url")
  detectedAt  DateTime @map("detected_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("insider_alerts")
  @@index([detectedAt(sort: Desc)], map: "insider_alerts_detected_idx")
}

model MessageUsage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  surface   String   // 'console' | 'explorer' | 'insider'
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("message_usages")
  @@index([userId, createdAt], map: "message_usages_user_created_idx")
}

model TrackedWallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  address   String
  label     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address], map: "tracked_wallets_user_address_uniq")
  @@map("tracked_wallets")
  @@index([userId, createdAt], map: "tracked_wallets_user_created_idx")
}

model ChatSession {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  title            String        @default("New chat")
  surface          String        @default("console")
  summary          String?       @db.Text
  summaryUpdatedAt DateTime?     @map("summary_updated_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages         ChatMessage[]

  @@map("chat_sessions")
  @@index([userId, updatedAt(sort: Desc)], map: "chat_sessions_user_updated_idx")
  @@index([userId, surface, updatedAt(sort: Desc)], map: "chat_sessions_user_surface_updated_idx")
}

model ChatMessage {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @map("session_id") @db.Uuid
  role      String      // 'user' | 'assistant'
  text      String
  dataJson  Json?       @map("data_json")
  feedback  String?     // 'up' | 'down' | null
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
  @@index([sessionId, createdAt], map: "chat_messages_session_created_idx")
}
